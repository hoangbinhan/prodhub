---
/**
 * Modal showing the contact email. Open it from any element with
 * `data-open-contact`. Uses the native <dialog> (focus trap, Esc to close).
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { SITE } from '../config';
---

<dialog
  id="contact-dialog"
  aria-labelledby="contact-dialog-title"
  class="m-auto w-[420px] max-w-[calc(100vw-32px)] rounded-[20px] border border-line bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/40"
>
  <div class="flex flex-col gap-5 p-7">
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-1">
        <h2 id="contact-dialog-title" class="m-0 font-display text-2xl font-semibold tracking-[-0.01em]">Contact</h2>
        <p class="m-0 text-[15px] text-muted">Questions, feedback or collaboration — email me.</p>
      </div>
      <form method="dialog">
        <button
          type="submit"
          aria-label="Close"
          class="-mt-1 -mr-2 flex size-11 cursor-pointer items-center justify-center rounded-full text-muted hover:bg-chip hover:text-ink"
        >
          <Icon name="x" size={20} />
        </button>
      </form>
    </div>

    <div class="flex items-center gap-2 rounded-[14px] border border-line bg-paper py-2 pr-2 pl-4">
      <span class="min-w-0 flex-1 truncate text-[15px] font-medium select-all">{SITE.email}</span>
      <button
        type="button"
        data-copy-email={SITE.email}
        class="inline-flex min-h-10 shrink-0 cursor-pointer items-center gap-1.5 rounded-full bg-white px-3.5 text-sm font-semibold text-ink ring-1 ring-line hover:ring-ink"
      >
        <Icon name="copy" size={16} />
        <span data-copy-label>Copy</span>
      </button>
    </div>

    <Button href={`mailto:${SITE.email}`} variant="accent" class="w-full">
      <Icon name="mail" size={18} />
      Send email
    </Button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;

  document.querySelectorAll('[data-open-contact]').forEach((el) =>
    el.addEventListener('click', () => dialog?.showModal()),
  );

  // Click on the backdrop (outside the panel) closes the dialog.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  const copyBtn = dialog?.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyLabel = copyBtn?.querySelector('[data-copy-label]');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copyEmail!);
      if (copyLabel) copyLabel.textContent = 'Copied';
    } catch {
      if (copyLabel) copyLabel.textContent = 'Select & copy';
    }
    setTimeout(() => copyLabel && (copyLabel.textContent = 'Copy'), 2000);
  });
</script>
