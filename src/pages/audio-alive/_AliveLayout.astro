---
/**
 * Standalone shell for the Audio Alive pages. Mirrors the Android app's own dark teal
 * look, so it deliberately does not use the hub's BaseLayout/Tailwind (see ./_design.md).
 */
import './_alive.css';
import { APP } from './_content';
import HubBar from '../../components/HubBar.astro';

interface Props {
  title: string;
  description: string;
  /** Schema.org JSON-LD graph nodes for this page. */
  jsonLd: Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(APP.ogImage, Astro.site);
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd });
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content={APP.developer} />
    <meta name="theme-color" content="#0B0E10" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={APP.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="Audio Alive — Fix USB-C to 3.5mm dongles that cut off your audio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href={APP.icon128} />
    <link rel="apple-touch-icon" href={APP.icon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <HubBar />
      <slot />

      <footer>
        <p>
          © {year} {APP.name} · Made by
          <a href="https://github.com/hoangbinhan" target="_blank" rel="noopener">{APP.developer}</a>
          · <a href="/audio-alive/privacy/">Privacy Policy</a> · <a href="/">All apps</a>
        </p>
      </footer>
    </div>
  </body>
</html>
