---
/**
 * Cloudflare Pages serves dist/404.html with a real 404 status for unknown URLs.
 * Without it, Pages falls back to SPA mode and answers every URL with the home page (200),
 * which search engines treat as duplicate/soft-404 pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found — ProdHub" description="This page does not exist.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="container-page flex min-h-[70vh] flex-col items-start justify-center gap-6 py-24">
    <span class="text-[13px] font-semibold tracking-[0.08em] text-accent uppercase">404</span>
    <h1 class="m-0 font-display text-[clamp(36px,5vw,60px)] leading-[1.05] font-bold tracking-[-0.03em]">
      This page does not exist.
    </h1>
    <p class="m-0 max-w-[520px] text-[17px] leading-relaxed text-muted">
      The link may be old or mistyped. Every app lives on the home page.
    </p>
    <Button href="/" variant="dark">See all apps</Button>
  </main>
</BaseLayout>
