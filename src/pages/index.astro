---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppTile from '../components/AppTile.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIALS, PLATFORM_FILTERS, DESKTOP_PLATFORMS } from '../config';
import { getProducts, productHref } from '../lib/content';

const products = await getProducts();

/** Filter groups each card belongs to (matches PLATFORM_FILTERS). */
const groupsFor = (platforms: string[]) => {
  const groups = new Set(platforms);
  if (platforms.some((p) => DESKTOP_PLATFORMS.includes(p))) groups.add('Desktop');
  // "Android beta" etc. still count as Android.
  if (platforms.some((p) => p.startsWith('Android'))) groups.add('Android');
  // Browser extensions run on desktop browsers.
  if (platforms.some((p) => /extension/i.test(p))) groups.add('Desktop');
  return [...groups].join(' ');
};
---

<BaseLayout title={SITE.siteTitle} description={SITE.intro}>
  <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
    <nav class="container-page flex flex-wrap items-center justify-between gap-4 py-[18px]">
      <a href="/" aria-label="Home" class="flex items-center text-ink no-underline hover:text-ink">
        <span
          class="flex size-8 items-center justify-center rounded-lg bg-ink font-display text-base font-bold text-paper"
          aria-hidden="true">{SITE.studioMono}</span
        >
      </a>
      <div class="flex flex-wrap items-center gap-1">
        <Button variant="dark" class="font-medium" aria-haspopup="dialog" data-open-contact>Contact</Button>
      </div>
    </nav>
  </header>

  <main>
    <section class="container-page flex flex-col gap-6 pt-14 pb-18">
      <span class="text-[13px] font-semibold tracking-[0.08em] text-accent uppercase">{SITE.eyebrow}</span>
      <h1
        class="m-0 max-w-[880px] font-display text-[clamp(40px,6vw,76px)] leading-[1.02] font-bold tracking-[-0.03em]"
      >
        {SITE.headline}
      </h1>
      <p class="m-0 max-w-[620px] text-[19px] leading-relaxed text-muted">{SITE.intro}</p>
    </section>

    <section id="products" class="container-page flex scroll-mt-6 flex-col gap-7 pt-6 pb-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="m-0 font-display text-[34px] font-semibold tracking-[-0.02em]">Products</h2>
        <div role="group" aria-label="Filter by platform" class="flex flex-wrap gap-1.5 rounded-full bg-well p-1">
          {
            PLATFORM_FILTERS.map((tab, i) => (
              <button
                type="button"
                data-filter={tab}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="min-h-10 cursor-pointer rounded-full px-4 py-2 text-sm font-medium text-body transition-colors hover:text-ink aria-pressed:bg-accent aria-pressed:text-white"
              >
                {tab}
              </button>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(320px,100%),1fr))] gap-5" data-product-grid>
        {
          products.map(({ id, data }) => {
            const external = !!data.url;
            return (
              <article
                data-groups={groupsFor(data.platforms)}
                class="group relative flex cursor-pointer flex-col gap-[18px] rounded-[20px] border border-line bg-white p-7 transition-[transform,box-shadow,border-color] duration-200 ease-out hover:border-line-strong hover:shadow-[0_12px_32px_-12px_rgb(17_17_20/0.18)] has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent motion-safe:hover:-translate-y-1 motion-safe:active:translate-y-0 motion-safe:active:scale-[0.985] active:shadow-sm"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="transition-transform duration-200 ease-out motion-safe:group-hover:scale-105">
                    <AppTile mono={data.mono} color={data.accent} icon={data.icon} />
                  </span>
                  <StatusBadge status={data.status} />
                </div>
                <div class="flex flex-col gap-2">
                  <h3 class="m-0 font-display text-2xl font-semibold tracking-[-0.01em]">
                    {/* Stretched link: its ::after covers the whole card, so the card is one click target. */}
                    <a
                      href={data.url ?? productHref(id)}
                      class="inline-flex items-center gap-2 text-ink no-underline outline-none after:absolute after:inset-0 after:rounded-[20px] after:content-[''] hover:text-ink"
                      {...(external && { target: '_blank', rel: 'noopener' })}
                    >
                      {data.name}
                      <Icon
                        name={external ? 'arrow-up-right' : 'arrow-right'}
                        size={20}
                        class:list={[
                          'text-faint transition-[color,transform] duration-200 ease-out group-hover:text-accent',
                          external
                            ? 'motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5'
                            : 'motion-safe:group-hover:translate-x-1',
                        ]}
                      />
                      {external && <span class="sr-only">(opens in a new tab)</span>}
                    </a>
                  </h3>
                  <p class="m-0 text-[15px] leading-[1.55] text-muted">{data.desc}</p>
                </div>
                <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0" aria-label="Platforms">
                  {data.platforms.map((p) => (
                    <li class="rounded-md bg-chip px-2.5 py-[5px] text-xs font-medium text-body">{p}</li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
      <p data-empty hidden class="m-0 text-[15px] text-muted">No apps for this platform yet.</p>
    </section>

  </main>

  <footer class="border-t border-line">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 pt-10 pb-14 text-sm text-muted">
      <span>© {new Date().getFullYear()}. All rights reserved.</span>
      <nav aria-label="Social links">
        <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer me" class="text-body hover:text-ink">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </footer>

  <ContactDialog />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-product-grid] > article');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter!;
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === 'All' || card.dataset.groups!.split(' ').includes(filter);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>
